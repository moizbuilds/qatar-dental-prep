# Anthropic API key for Ask mode (get one at https://console.anthropic.com).
# Ask mode calls claude-sonnet-5; quiz mode works without this.
ANTHROPIC_API_KEY=

# Shared passcode to enter the app (single user).
APP_PASSCODE=

# Random secret used to sign the session cookie. Required (the app refuses to
# sign sessions without it). Must be at least 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase (production data backend). When SUPABASE_URL is set the app uses
# Postgres; otherwise it falls back to local SQLite (dev + tests). The deployed
# app uses the ANON key (least privilege; RLS blocks deletes).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — ONLY for the one-time corpus loader (scripts/load-supabase.ts),
# which clears + reloads tables. Bypasses RLS; keep it operator-only, never ship
# it to the client or set it in the deployed app.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set to 1 ONLY when deployed behind a trusted reverse proxy that
# overwrites the X-Forwarded-For header; otherwise the login rate limiter
# ignores the client-supplied header (safe default for local single-instance).
# TRUST_PROXY=1
